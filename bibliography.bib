@article {Chatelain2026.01.09.698203,
	author = {Chatelain, Yohan and Soko-lowski, Andrzej and Sharp, Madeleine and Poline, Jean-Baptiste and Glatard, Tristan},
	title = {The practical impact of numerical variability on structural MRI measures of Parkinson{\textquoteright}s disease},
	elocation-id = {2026.01.09.698203},
	year = {2026},
	doi = {10.64898/2026.01.09.698203},
	publisher = {Cold Spring Harbor Laboratory},
	abstract = {Numerical variability is rarely quantified in neuroimaging despite many biomarkers relying on subtle morphometric differences across individuals. We instrumented FreeSurfer, a widely used neuroimaging pipeline, to simulate numerical differences across computational environments, and used it to measure numerical variability in MRI analyses of Parkinson{\textquoteright}s disease patients and controls. In multiple cortical and subcortical regions, numerical variation reached nearly one-third of the population variability, altering statistical conclusions about group differences and clinical associations. To address this, we developed a practical tool that estimates the Numerical-Population Variability Ratio (NPVR), enabling researchers to assess the impact of numerical noise in existing studies. By applying this framework to thirteen previously published studies reporting MRI measures of Parkinson{\textquoteright}s disease, we quantified the probability of numerically induced false positives in the literature, highlighting a substantial impact of numerical variability on MRI measures of Parkinson{\textquoteright}s disease. These results underscore the importance of systematically evaluating numerical stability in neuroimaging.Competing Interest StatementThe authors have declared no competing interest.Michael J. Fox Foundation, MJFF- 021134},
	URL = {https://www.biorxiv.org/content/early/2026/01/09/2026.01.09.698203},
	eprint = {https://www.biorxiv.org/content/early/2026/01/09/2026.01.09.698203.full.pdf},
	journal = {bioRxiv}
}

